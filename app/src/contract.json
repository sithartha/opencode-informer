    "option": { "required": ["label"] },
    "question.asked": { "required": ["sessionID", "requestID", "title", "options"] },
    "session.cost": { "required": ["sessionID", "cost"] },
    "turn.completed": { "required": ["sessionID", "summary"] },
    "actionable.resolved": { "required": ["sessionID", "requestID"] },
    "resolution.request": { "required": ["requestID", "action"] },
    "doorbell": { "required": ["kind"] },
    "pair.request": { "required": ["deviceName"] },
    "pair.status": { "required": ["status"] }
  },
