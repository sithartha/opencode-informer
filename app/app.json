{
  "expo": {
    "name": "OpenCode Informer",
    "slug": "opencode-informer",
    "scheme": "opencodeinformer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.opencode.informer",
      "appleTeamId": "6R3Q9WJ93G",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "OpenCode Informer uses Bluetooth to wake your phone when an agent needs attention.",
        "NSLocalNetworkUsageDescription": "OpenCode Informer connects to your Mac on the local network to show agent activity and send approvals.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ru.opencode.informer",
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "react-native-ble-plx",
      "expo-notifications",
      "expo-live-activity",
      "./plugins/withSceneLifecycle",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "ru.opencode.informer.LiveActivity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "a09d4e8b-0609-4af2-8964-69fd88cf2f82"
      }
    },
    "owner": "sithartha"
  }
}
